# DealFlow360 frontend — environment template
#
#   cp .env.example .env.local
#
# The dev server must be served from an origin the backend whitelists. Its
# CORS_ORIGINS defaults to http://localhost:5173 and http://localhost:3000, so
# run with `npm run dev` (5173) or `PORT=3000 npm run dev`.

# Where the API lives.
VITE_API_BASE=http://127.0.0.1:8010

# ------------------------------------------------------------------ demo
# Shows the "Demo accounts" picker on the login page and the in-app role
# switcher. Both use the ordinary POST /auth/login flow against the seeded
# users — they mint no tokens and skip no authorisation.
#
# Unset  -> enabled in development, disabled in a production build
# true   -> enabled everywhere (use for a hosted demo)
# false  -> compiled out entirely
VITE_DEMO_MODE=

# The password `scripts/seed.py` assigns to every seeded demo user. Must match
# the backend's SEED_DEFAULT_PASSWORD.
VITE_DEMO_PASSWORD=Password123!
