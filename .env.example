# DealFlow360 — environment template
#
#   cp .env.example .env
#
# Then, at minimum, replace JWT_SECRET_KEY. The application refuses to start
# with the placeholder value when ENVIRONMENT is staging or production.
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------------------------------------------------------------- app
APP_NAME=DealFlow360
APP_VERSION=1.0.0
# development | test | staging | production
ENVIRONMENT=development
DEBUG=true
API_PREFIX=

# ----------------------------------------------------------- database
# Must be postgresql+asyncpg://. The app rejects any other driver.
# docker-compose publishes PostgreSQL on 5433 to avoid clashing with a local install.
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5433/mydb
TEST_DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5433/mydb_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------- jwt
# REPLACE THIS. Leaving the placeholder means anyone with repository access can
# forge an ADMIN token for any tenant.
JWT_SECRET_KEY=REPLACE_ME_WITH_A_64_BYTE_URLSAFE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --------------------------------------------------------------- cors
# Comma-separated exact origins. "*" is rejected in staging/production.
# Authentication uses an Authorization header, not cookies, so credentialed
# CORS is not required.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------- rate limiting
# Applies to /auth/login, /auth/signup and /auth/refresh.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# --------------------------------------------------- commercial engine
DEFAULT_TAX_RATE_PCT=0.0
MONEY_DECIMAL_PLACES=2

# ------------------------------------------------------- policy engine
# Defaults for new organizations. Per-tenant overrides live in
# organization_settings and are editable via PATCH /admin/settings.
# See README "Blended Risk Algorithm" for the derivation of each weight.
RISK_DISCOUNT_OVERAGE_WEIGHT=3.0
RISK_BREADTH_WEIGHT=5.0
RISK_MARGIN_WEIGHT=5.0
RISK_DEPTH_WEIGHT=0.4
RISK_FINANCE_ESCALATION_THRESHOLD=60.0

# ------------------------------------------------------------ signals
STALLED_DEAL_DAYS=14
DISCOUNT_ANOMALY_SIGMA=2.0
DISCOUNT_ANOMALY_MIN_SAMPLES=5
APPROVAL_SLA_HOURS=24
RECOMMENDATION_MIN_MARGIN_PCT=0.0

# ------------------------------------------------------------ seeding
# Demo only. Never use outside a demo.
SEED_DEFAULT_PASSWORD=Password123!
